{
    "version": 2,
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.2"
        }
    },
    "routes": [
        { "src": "/assets/(.*)", "dest": "/public/assets/$1" },
        { "src": "/build/(.*)", "dest": "/public/build/$1" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ],
    "env": {
        "LARAVEL_STORAGE_PATH": "/tmp",
        "APP_CONFIG_CACHE": "/tmp/laravel-config-cache-v2.php",
        "APP_EVENTS_CACHE": "/tmp/laravel-events-cache-v2.php",
        "APP_PACKAGES_CACHE": "/tmp/laravel-packages-cache-v2.php",
        "APP_ROUTES_CACHE": "/tmp/laravel-routes-cache-v2.php",
        "APP_SERVICES_CACHE": "/tmp/laravel-services-cache-v2.php",
        "VIEW_COMPILED_PATH": "/tmp",
        "CACHE_STORE": "array",
        "SESSION_DRIVER": "cookie",
        "SESSION_SECURE_COOKIE": "true",
        "LOG_CHANNEL": "stderr"
    }
}
